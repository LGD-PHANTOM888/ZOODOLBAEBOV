---
const { node, label, noteContent } = Astro.props;

const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
})[char]);

const style = `left:${node.x}px;top:${node.y}px;width:${node.width}px;height:${node.height}px;${node.color ? `--node-color:${node.color};` : ''}`;
const classes = `canvas-node canvas-node--${node.kind}`;
const Note = node.kind === 'note' && noteContent ? noteContent.get(node.slug) : null;

const parts = [
  `<span class="canvas-node-kind">${esc(label)}</span>`,
  `<span class="canvas-node-title">${esc(node.title || 'Без названия')}</span>`,
];

if (node.kind === 'text') {
  parts.push(`<span class="canvas-node-text">${esc(node.text)}</span>`);
  parts.push('<button class="canvas-node-expand" type="button" data-canvas-expand title="Развернуть">⤢</button>');
}
if (node.kind === 'missing') {
  parts.push(`<span class="canvas-node-text">${esc(node.preview)}</span>`);
}
if (node.kind === 'image') {
  parts.push(`<img data-media-src="${esc(node.url)}" alt="${esc(node.title)}" loading="lazy" decoding="async" fetchpriority="low" draggable="false" />`);
}
if (node.kind === 'video') {
  parts.push(`<video data-media-src="${esc(node.url)}" controls muted preload="none" playsinline controlsList="nodownload" disablePictureInPicture disableRemotePlayback oncontextmenu="return false" draggable="false"></video>`);
}
if (node.kind === 'audio') {
  parts.push(`<audio data-media-src="${esc(node.url)}" controls preload="none"></audio>`);
}
if (node.kind === 'pdf' || node.kind === 'other' || node.kind === 'link') {
  parts.push(`<span class="canvas-node-file">${esc(node.url || node.preview)}</span>`);
}

const body = parts.join('');
---

{node.kind === 'note' ? (
  <div class={classes} style={style} data-canvas-node={node.id}>
    <span class="canvas-node-kind" set:html={esc(label)} />
    <span class="canvas-node-title" set:html={esc(node.title || 'Без названия')} />
    <button class="canvas-node-expand" type="button" data-canvas-expand title="Развернуть">⤢</button>
    <div class="canvas-node-body prose">
      {Note ? <Note /> : <span class="canvas-node-text">{node.preview || 'Открыть запись'}</span>}
    </div>
  </div>
) : node.url && node.kind !== 'video' ? (
  <a
    class={classes}
    style={style}
    href={node.url}
    target={node.kind === 'link' ? '_blank' : undefined}
    rel={node.kind === 'link' ? 'noopener' : undefined}
    data-canvas-node={node.id}
  >
    <Fragment set:html={body} />
  </a>
) : (
  <div class={classes} style={style} data-canvas-node={node.id}>
    <Fragment set:html={body} />
  </div>
)}

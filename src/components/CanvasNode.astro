---
const { node, label } = Astro.props;

const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
})[char]);

const style = `left:${node.x}px;top:${node.y}px;width:${node.width}px;height:${node.height}px;${node.color ? `--node-color:${node.color};` : ''}`;
const classes = `canvas-node canvas-node--${node.kind}`;

const parts = [
  `<span class="canvas-node-kind">${esc(label)}</span>`,
  `<span class="canvas-node-title">${esc(node.title || 'Без названия')}</span>`,
];

if (node.kind === 'text') parts.push(`<span class="canvas-node-text">${esc(node.text)}</span>`);
if (node.kind === 'note') parts.push(`<span class="canvas-node-text">${esc(node.preview || 'Открыть заметку →')}</span>`);
if (node.kind === 'locked' || node.kind === 'missing') {
  parts.push(`<span class="canvas-node-text">${esc(node.preview)}</span>`);
}
if (node.kind === 'image') {
  parts.push(`<img src="${esc(node.url)}" alt="${esc(node.title)}" loading="lazy" draggable="false" />`);
}
if (node.kind === 'video') {
  parts.push(`<video src="${esc(node.url)}" controls muted preload="metadata" playsinline></video>`);
}
if (node.kind === 'audio') {
  parts.push(`<audio src="${esc(node.url)}" controls preload="metadata"></audio>`);
}
if (node.kind === 'pdf' || node.kind === 'other' || node.kind === 'link') {
  parts.push(`<span class="canvas-node-file">${esc(node.url || node.preview)}</span>`);
}

const body = parts.join('');
---

{node.url ? (
  <a
    class={classes}
    style={style}
    href={node.url}
    target={node.kind === 'note' ? undefined : '_blank'}
    rel={node.kind === 'note' ? undefined : 'noopener'}
    data-canvas-node={node.id}
  >
    <Fragment set:html={body} />
  </a>
) : (
  <div class={classes} style={style} data-canvas-node={node.id}>
    <Fragment set:html={body} />
  </div>
)}

---
const { canvas, noteContent } = Astro.props;
import CanvasNode from './CanvasNode.astro';
const bounds = canvas.bounds;

const byId = new Map(canvas.nodes.map((node) => [node.id, node]));
const point = (node, side) => {
  const cx = node.x - bounds.x + node.width / 2;
  const cy = node.y - bounds.y + node.height / 2;
  const left = node.x - bounds.x;
  const top = node.y - bounds.y;
  if (side === 'left') return { x: left, y: cy };
  if (side === 'right') return { x: left + node.width, y: cy };
  if (side === 'top') return { x: cx, y: top };
  return { x: cx, y: top + node.height };
};

const lines = canvas.edges.map((edge) => {
  const from = byId.get(edge.from);
  const to = byId.get(edge.to);
  if (!from || !to) return null;
  const a = point(from, edge.fromSide);
  const b = point(to, edge.toSide);
  return { ...edge, x1: a.x, y1: a.y, x2: b.x, y2: b.y };
}).filter(Boolean);

const orderedNodes = canvas.nodes
  .map((node) => ({ ...node, x: node.x - bounds.x, y: node.y - bounds.y }))
  .sort((a, b) => {
    if (a.kind === 'group' && b.kind !== 'group') return -1;
    if (b.kind === 'group' && a.kind !== 'group') return 1;
    return 0;
  });

const kindLabel = {
  note: 'ЗАПИСЬ', image: 'ФОТО', video: 'ВИДЕО', audio: 'АУДИО',
  pdf: 'PDF', other: 'ФАЙЛ', text: 'ТЕКСТ', link: 'ССЫЛКА',
  group: 'ГРУППА', missing: 'НЕ НАЙДЕН',
};
---

<div class="canvas-shell" data-canvas-shell>
  <div class="canvas-toolbar">
    <span class="eyebrow" style="font-size:9px">CANVAS VIEWER</span>
    <span class="canvas-toolbar-sep"></span>
    <button type="button" data-canvas-action="out" title="Уменьшить">−</button>
    <span class="canvas-zoom" data-canvas-zoom>100%</span>
    <button type="button" data-canvas-action="in" title="Увеличить">+</button>
    <button type="button" data-canvas-action="fit" title="Вписать всё">ВМЕСТИТЬ</button>
    <span class="canvas-toolbar-sep"></span>
    <span class="canvas-toolbar-hint">колесо — масштаб · тянуть — панорама · тап — выделить узел</span>
    <span class="canvas-toolbar-touch">ТЯНУТЬ — ДВИГАТЬ · ДВА ПАЛЬЦА — МАСШТАБ · ТАП — ВЫДЕЛИТЬ</span>
  </div>

  <div class="canvas-viewport" data-canvas-viewport>
    <div
      class="canvas-stage"
      data-canvas-stage
      style={`width:${bounds.width}px;height:${bounds.height}px;`}
    >
      <svg
        class="canvas-edges"
        viewBox={`0 0 ${bounds.width} ${bounds.height}`}
        width={bounds.width}
        height={bounds.height}
        aria-hidden="true"
      >
        {lines.map((line) => (
          <line
            x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2}
            data-edge-from={line.from} data-edge-to={line.to}
          />
        ))}
      </svg>

      {orderedNodes.map((node) => (
        <CanvasNode node={node} label={kindLabel[node.kind] || node.kind.toUpperCase()} noteContent={noteContent} />
      ))}
    </div>
  </div>

  <div class="canvas-status">
    <span>УЗЛОВ <b>{canvas.stats.nodes}</b></span>
    <span>СВЯЗЕЙ <b>{canvas.stats.edges}</b></span>
    <span>ЗАПИСИ <b>{canvas.stats.notes}</b></span>
    <span>МЕДИА <b>{canvas.stats.media}</b></span>
  </div>

  <div class="canvas-modal" data-canvas-modal hidden>
    <div class="canvas-modal-backdrop" data-canvas-modal-close></div>
    <div class="canvas-modal-box">
      <div class="canvas-modal-head">
        <span data-canvas-modal-title></span>
        <button type="button" data-canvas-modal-close aria-label="Закрыть">×</button>
      </div>
      <div class="canvas-modal-body" data-canvas-modal-body></div>
    </div>
  </div>
</div>

<script define:vars={{ canvas }}>
  const shell = document.querySelector('[data-canvas-shell]');
  const viewport = shell?.querySelector('[data-canvas-viewport]');
  const stage = shell?.querySelector('[data-canvas-stage]');
  const zoomLabel = shell?.querySelector('[data-canvas-zoom]');
  const bounds = canvas.bounds;
  const lite = matchMedia('(hover: none), (pointer: coarse), (max-width: 768px)').matches;
  if (lite) shell.dataset.lite = 'true';

  // Авторское видео: без контекстного меню «Сохранить» и без перетаскивания файла.
  shell?.addEventListener('contextmenu', (event) => {
    if (event.target instanceof Element && event.target.closest('video')) event.preventDefault();
  });
  shell?.addEventListener('dragstart', (event) => {
    if (event.target instanceof Element && event.target.closest('video, img')) event.preventDefault();
  });

  // Медиа получают источник сразу. Картинки грузит браузер лениво (loading=lazy),
  // видео и аудио — только при запуске (preload=none). Порога зуома больше нет.
  const media = [...shell.querySelectorAll('[data-media-src]')];
  for (const el of shell.querySelectorAll('.canvas-node-body img, .canvas-node-body video')) {
    const src = el.getAttribute('src');
    if (!src) continue;
    el.dataset.mediaSrc = src;
    el.removeAttribute('src');
    if (el.tagName === 'VIDEO') el.preload = 'none';
    media.push(el);
  }
  for (const el of media) {
    const src = el.dataset.mediaSrc;
    if (!src) continue;
    if (el.tagName === 'IMG') {
      el.loading = 'lazy';
      el.decoding = 'async';
    }
    if (el.tagName === 'VIDEO' || el.tagName === 'AUDIO') el.preload = 'none';
    if (!el.getAttribute('src')) el.setAttribute('src', src);
    el.closest('[data-canvas-node]')?.setAttribute('data-media-ready', 'true');
  }

  let scale = 1;
  let tx = 0;
  let ty = 0;
  let touched = false;

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  // Рёбра индексируются один раз. Выделение ставим только явным тапом/кликом
  // по самой заметке; наведение и панорама его не трогают.
  const edgesByNode = new Map();
  for (const line of shell?.querySelectorAll('[data-edge-from]') || []) {
    for (const key of [line.dataset.edgeFrom, line.dataset.edgeTo]) {
      if (!key) continue;
      if (!edgesByNode.has(key)) edgesByNode.set(key, []);
      edgesByNode.get(key).push(line);
    }
  }
  const nodesById = new Map();
  for (const node of shell?.querySelectorAll('[data-canvas-node]') || []) {
    nodesById.set(node.dataset.canvasNode, node);
  }
  let selectedId = null;

  function clearSelection() {
    if (!selectedId) return;
    nodesById.get(selectedId)?.classList.remove('is-selected');
    for (const line of edgesByNode.get(selectedId) || []) line.classList.remove('is-active');
    delete shell.dataset.activeNode;
    selectedId = null;
  }

  function selectNode(node) {
    const id = node.dataset.canvasNode;
    if (!id) return;
    clearSelection();
    selectedId = id;
    node.classList.add('is-selected');
    shell.dataset.activeNode = id;
    for (const line of edgesByNode.get(id) || []) line.classList.add('is-active');
  }

  let lastPlayerScale = 0;
  function apply() {
    stage.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    if (zoomLabel) zoomLabel.textContent = `${Math.round(scale * 100)}%`;
    // Плееры video создаём только когда узел стал достаточно крупным.
    if (Math.abs(scale - lastPlayerScale) >= 0.02) {
      lastPlayerScale = scale;
      window.__refreshVideoPlayers?.();
    }
  }

  // С style writes только раз на кадр — плавнее при панораме на слабых GPU.
  let applyFrame = 0;
  function scheduleApply() {
    if (applyFrame) return;
    applyFrame = requestAnimationFrame(() => {
      applyFrame = 0;
      apply();
    });
  }

  function fit() {
    const w = viewport.clientWidth || 800;
    const h = viewport.clientHeight || 600;
    const pad = lite ? 24 : 80;
    scale = clamp(Math.min((w - pad) / bounds.width, (h - pad) / bounds.height), 0.03, 1.25);
    tx = (w - bounds.width * scale) / 2;
    ty = (h - bounds.height * scale) / 2;
    apply();
  }

  function zoomAt(factor, px, py) {
    const next = clamp(scale * factor, 0.03, 2.5);
    tx = px - (px - tx) * (next / scale);
    ty = py - (py - ty) * (next / scale);
    scale = next;
    touched = true;
    scheduleApply();
  }

  function center() {
    return { px: viewport.clientWidth / 2, py: viewport.clientHeight / 2 };
  }

  shell?.querySelectorAll('[data-canvas-action]').forEach((button) => {
    button.addEventListener('click', () => {
      const action = button.dataset.canvasAction;
      const { px, py } = center();
      if (action === 'in') zoomAt(1.2, px, py);
      if (action === 'out') zoomAt(1 / 1.2, px, py);
      if (action === 'fit') { touched = false; fit(); }
    });
  });

  viewport?.addEventListener('wheel', (event) => {
    event.preventDefault();
    const rect = viewport.getBoundingClientRect();
    zoomAt(event.deltaY < 0 ? 1.12 : 1 / 1.12, event.clientX - rect.left, event.clientY - rect.top);
  }, { passive: false });

  // Универсальные жесты: панорама может начаться даже на заметке, если палец
  // сдвинулся; два пальца дают масштаб. Тап без движения остаётся выбором узла.
  const pointers = new Map();
  let pan = null;
  let pinch = null;
  let lastDragEndAt = 0;

  viewport?.addEventListener('pointerdown', (event) => {
    if (event.target.closest('[data-canvas-expand], .canvas-modal')) return;
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
    if (pointers.size === 1) {
      pan = { id: event.pointerId, x: event.clientX, y: event.clientY, tx, ty, started: false };
    } else if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const rect = viewport.getBoundingClientRect();
      pinch = {
        dist: Math.hypot(a.x - b.x, a.y - b.y) || 1,
        scale0: scale,
        wx: ((a.x + b.x) / 2 - rect.left - tx) / scale,
        wy: ((a.y + b.y) / 2 - rect.top - ty) / scale,
      };
      pan = null;
      clearSelection();
      viewport.classList.add('is-dragging');
    }
  });

  window.addEventListener('pointermove', (event) => {
    if (!pointers.has(event.pointerId)) return;
    pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

    if (pointers.size >= 2 && pinch) {
      const [a, b] = [...pointers.values()];
      const rect = viewport.getBoundingClientRect();
      const dist = Math.hypot(a.x - b.x, a.y - b.y) || 1;
      const next = clamp(pinch.scale0 * (dist / pinch.dist), 0.03, 2.5);
      tx = (a.x + b.x) / 2 - rect.left - pinch.wx * next;
      ty = (a.y + b.y) / 2 - rect.top - pinch.wy * next;
      scale = next;
      touched = true;
      scheduleApply();
      return;
    }

    if (!pan || pan.id !== event.pointerId) return;
    const dx = event.clientX - pan.x;
    const dy = event.clientY - pan.y;
    if (!pan.started) {
      const limit = event.pointerType === 'touch' ? 8 : 4;
      if (Math.hypot(dx, dy) < limit) return;
      pan.started = true;
      try { viewport.setPointerCapture(event.pointerId); } catch { /* capture is optional */ }
      viewport.classList.add('is-dragging');
      clearSelection();
    }
    tx = pan.tx + dx;
    ty = pan.ty + dy;
    touched = true;
    scheduleApply();
  }, { passive: true });

  function endPointer(event) {
    if (!pointers.has(event.pointerId)) return;
    const wasDragging = Boolean(pan?.started || pinch);
    pointers.delete(event.pointerId);
    if (pointers.size < 2) pinch = null;
    if (!pointers.size) {
      pan = null;
      viewport?.classList.remove('is-dragging');
      if (wasDragging) lastDragEndAt = Date.now();
    }
  }
  window.addEventListener('pointerup', endPointer);
  window.addEventListener('pointercancel', endPointer);

  // Единственное место, где ставится выделение: обычный клик/тап по узлу.
  viewport?.addEventListener('click', (event) => {
    if (Date.now() - lastDragEndAt < 400) {
      event.preventDefault();
      event.stopPropagation();
      return;
    }
    const node = event.target.closest('[data-canvas-node]');
    if (node) selectNode(node);
    else clearSelection();
  }, true);

  const modal = shell?.querySelector('[data-canvas-modal]');
  const modalBody = modal?.querySelector('[data-canvas-modal-body]');
  const modalTitle = modal?.querySelector('[data-canvas-modal-title]');
  let focusReturn = null;

  function closeModal() {
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    if (modalBody) modalBody.replaceChildren();
    focusReturn?.focus?.();
    focusReturn = null;
  }

  shell?.querySelectorAll('[data-canvas-expand]').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (!modal || !modalBody) return;
      const node = button.closest('[data-canvas-node]');
      const source = node?.querySelector('.canvas-node-body, .canvas-node-text');
      if (!source) return;
      focusReturn = button;
      if (modalTitle) modalTitle.textContent = node.querySelector('.canvas-node-title')?.textContent?.trim() || 'Холст';
      const clone = source.cloneNode(true);
      // Клон не наследует обработчики плеера — снимаем обёртку и навешиваем заново.
      clone.querySelectorAll('.video-player').forEach((player) => {
        const video = player.querySelector('video');
        if (video) player.replaceWith(video);
      });
      modalBody.replaceChildren(clone);
      window.__enhanceVideos?.(modalBody);
      modal.hidden = false;
      modalBody.scrollTop = 0;
    });
  });

  modal?.querySelectorAll('[data-canvas-modal-close]').forEach((button) => {
    button.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeModal();
  });

  new ResizeObserver(() => { if (!touched) fit(); }).observe(viewport);
  fit();
</script>

---
import manifest from '../data/manifest.json';

interface Props { active?: string }
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

const botUrl = 'https://t.me/Predlozkadegeneratos_bot';
const links = [
  { href: `${base}canvases/`, label: 'Холсты', key: 'canvases', external: false },
  { href: `${base}graph/`, label: 'Граф', key: 'graph', external: false },
  { href: botUrl, label: 'Предложка', key: 'bot', external: true },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={base} aria-label="На главную">
      <span class="brand-mark">З</span>
      <span class="brand-text">
        <span class="brand-title">{manifest.siteTitle}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Основная навигация">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          title={link.external ? '@Predlozkadegeneratos_bot' : undefined}
          data-active={active === link.key ? 'true' : 'false'}
        >{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" data-updates-open aria-label="Последние обновления (U)" title="Последние обновления (U)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
        </svg>
      </button>
      <button class="icon-btn" id="explorer-open" type="button" aria-label="Проводник (E)" title="Проводник (E)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 5h6l2 2h10v12H3z"></path><path d="M3 9h18"></path>
        </svg>
      </button>
      <button class="icon-btn" id="search-open" type="button" aria-label="Поиск (Ctrl+K)" title="Поиск (Ctrl+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

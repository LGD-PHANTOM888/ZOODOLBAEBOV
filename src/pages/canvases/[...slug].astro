---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CanvasView from '../../components/CanvasView.astro';
import manifest from '../../data/manifest.json';

export async function getStaticPaths() {
  const notes = (await getCollection('notes'))
    .filter((note) => note.data.kind === 'canvas')
    .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
  return notes.map((note, index) => ({
    params: { slug: note.data.slug },
    props: {
      note,
      prev: index > 0 ? notes[index - 1] : null,
      next: index < notes.length - 1 ? notes[index + 1] : null,
    },
  }));
}

const { note, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;

const allNotes = await getCollection('notes');
const noteContent = new Map();
for (const entry of allNotes) {
  noteContent.set(entry.data.slug, (await render(entry)).Content);
}

const canvas = (manifest.canvases as Record<string, any>)[note.data.slug] || null;
const backlinkSlugs = manifest.backlinks[note.data.slug] || [];
const backlinks = backlinkSlugs
  .map((slug: string) => manifest.notes.find((item) => item.slug === slug))
  .filter(Boolean)
  .slice(0, 8);
const date = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(note.data.updated);
---

<BaseLayout title={`${note.data.title} · ${manifest.siteTitle}`} description={note.data.description} active="canvases">
  <div class="note-layout">
    <article>
      <header class="note-header">
        <nav class="crumbs" aria-label="Навигация">
          <a href={base}>Главная</a><span>/</span>
          <a href={`${base}canvases/`}>Холсты</a><span>/</span>
          {note.data.folder && <><span>{note.data.folder}</span><span>/</span></>}
          <span>{note.data.title}</span>
        </nav>
        <h1 class="note-title">{note.data.title}</h1>
        <span class="kind-badge">◇ ХОЛСТ</span>
        <div class="note-meta">
          <span>◷ {date}</span>
          {note.data.folder && <span>◈ {note.data.folder}</span>}
        </div>
      </header>

      {canvas && <CanvasView canvas={canvas} noteContent={noteContent} />}

      <footer class="note-footer">
        <div class="prev-next">
          {prev && (
            <a class="pn-card" href={`${base}canvases/${prev.data.slug}/`}>
              <span>← новее</span><strong>{prev.data.title}</strong>
            </a>
          )}
          {next && (
            <a class="pn-card" href={`${base}canvases/${next.data.slug}/`}>
              <span>старее →</span><strong>{next.data.title}</strong>
            </a>
          )}
        </div>
      </footer>
    </article>

    {backlinks.length > 0 && (
      <aside class="side">
        <div class="side-box">
          <p class="side-title">Связанные холсты · {backlinkSlugs.length}</p>
          <div class="backlink-list">
            {backlinks.map((item: any) => (
              <a href={`${base}canvases/${item.slug}/`}>↳ {item.title}</a>
            ))}
          </div>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>

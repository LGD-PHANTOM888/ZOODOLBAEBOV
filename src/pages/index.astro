---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FolderTree from '../components/FolderTree.astro';
import manifest from '../data/manifest.json';

const base = import.meta.env.BASE_URL;
const botUrl = 'https://t.me/Predlozkadegeneratos_bot';
const canvases = [...manifest.notes];
const canvasList = Object.values(manifest.canvases as Record<string, any>);
const nodeCount = canvasList.reduce((sum, canvas) => sum + canvas.stats.nodes, 0);
const edgeCount = canvasList.reduce((sum, canvas) => sum + canvas.stats.edges, 0);
const linkCount = Object.values(manifest.backlinks).flat().length;
const folderCount = new Set(canvases.map((canvas) => canvas.folder).filter(Boolean)).size;

const news = (await getCollection('news'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const newsContent = new Map();
for (const item of news) newsContent.set(item.id, (await render(item)).Content);
const formatDate = (date) => new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(date);
---

<BaseLayout title={manifest.siteTitle} description={manifest.siteDescription}>
  <section class="hero">
    <div>
      <span class="eyebrow">ЗООПАРК ДОЛБОЕБОВ</span>
      <h1><span class="glitch" data-text="ЗООПАРК">ЗООПАРК</span><br /><em class="glitch glitch--accent" data-text="ДОЛБОЕБОВ">ДОЛБОЕБОВ</em></h1>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}canvases/`}>ХОЛСТЫ <span>→</span></a>
        <a class="btn btn-ghost" href={`${base}graph/`}>ГРАФ</a>
        <a class="btn btn-ghost" href={botUrl} target="_blank" rel="noopener noreferrer">ПРЕДЛОЖКА ↗</a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="orbit"></div>
      <div class="orbit orbit-2"></div>
      <div class="hero-core"><span>З</span></div>
      <div class="float-chip chip-1">холстов <b>{canvases.length}</b></div>
      <div class="float-chip chip-2">связей <b>{linkCount}</b></div>
      <div class="float-chip chip-3">узлов <b>{nodeCount}</b></div>
    </div>
  </section>

  <div class="stats">
    <div class="stat"><span class="stat-value">{canvases.length}</span><span class="stat-label">Холстов</span></div>
    <div class="stat"><span class="stat-value">{folderCount}</span><span class="stat-label">Папок</span></div>
    <div class="stat"><span class="stat-value">{nodeCount}</span><span class="stat-label">Узлов</span></div>
    <div class="stat"><span class="stat-value">{edgeCount}</span><span class="stat-label">Связей</span></div>
  </div>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Корень</span>
        <h2>Дерево холстов</h2>
      </div>
      <a href={`${base}canvases/`}>Открыть всё →</a>
    </div>
    <FolderTree label="КОРЕНЬ" />
  </section>

  <section class="section news-section" id="news">
    <div class="section-head">
      <div>
        <span class="eyebrow">Лента</span>
        <h2>Новинки</h2>
      </div>
      <div class="section-actions">
        <button class="section-link" type="button" data-updates-open>Последние обновления</button>
      </div>
    </div>

    {news.length > 0 ? (
      <div class="news-feed">
        {news.map((item) => {
          const Content = newsContent.get(item.id);
          return (
            <article class="news-card" id={`news-${item.data.slug}`}>
              <header class="news-card-head">
                <span class="news-date">◷ {formatDate(item.data.updated)}</span>
                <h3>{item.data.title}</h3>
                {item.data.description && <p class="news-description">{item.data.description}</p>}
              </header>
              <div class="prose news-body"><Content /></div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="news-empty">
        Папка «Новинки» пока пуста. Добавь текстовый файл в Obsidian — запись появится здесь после обновления сайта.
      </div>
    )}
  </section>
</BaseLayout>

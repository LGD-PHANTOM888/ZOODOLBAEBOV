---
import BaseLayout from '../layouts/BaseLayout.astro';
import manifest from '../data/manifest.json';
import folderUrl from '../utils/folder-url';

const base = import.meta.env.BASE_URL;
const canvases = [...manifest.notes];
const canvasList = Object.values(manifest.canvases as Record<string, any>);
const nodeCount = canvasList.reduce((sum, canvas) => sum + canvas.stats.nodes, 0);
const edgeCount = canvasList.reduce((sum, canvas) => sum + canvas.stats.edges, 0);
const linkCount = Object.values(manifest.backlinks).flat().length;

const folders = new Map();
for (const canvas of canvases) {
  const name = canvas.folder || 'Без раздела';
  folders.set(name, (folders.get(name) || 0) + 1);
}
const folderList = [...folders.entries()].sort((a, b) => b[1] - a[1]);
const formatDate = (date) => new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(date));
---

<BaseLayout title={manifest.siteTitle} description={manifest.siteDescription}>
  <section class="hero">
    <div>
      <span class="eyebrow">XXXLGDXXX // ARCHIVE</span>
      <h1><span class="glitch" data-text="ЗООПАРК">ЗООПАРК</span><br /><em>ДОЛБОЕБОВ</em></h1>
      <p class="hero-lead terminal-line">
        <span class="prompt">root@archive:~$</span> cat index<br />
        Архив холстов и связей.
        <span class="cursor">_</span>
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}notes/`}>ХОЛСТЫ <span>→</span></a>
        <a class="btn btn-ghost" href={`${base}graph/`}>ГРАФ</a>
        <a class="btn btn-ghost" href={`${base}predlozhka/`}>ПРЕДЛОЖКА</a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="orbit"></div>
      <div class="orbit orbit-2"></div>
      <div class="hero-core"><span>З</span></div>
      <div class="float-chip chip-1">холстов <b>{canvases.length}</b></div>
      <div class="float-chip chip-2">связей <b>{linkCount}</b></div>
      <div class="float-chip chip-3">узлов <b>{nodeCount}</b></div>
    </div>
  </section>

  <div class="stats">
    <div class="stat"><span class="stat-value">{canvases.length}</span><span class="stat-label">Холстов</span></div>
    <div class="stat"><span class="stat-value">{folderList.length}</span><span class="stat-label">Разделов</span></div>
    <div class="stat"><span class="stat-value">{nodeCount}</span><span class="stat-label">Узлов</span></div>
    <div class="stat"><span class="stat-value">{edgeCount}</span><span class="stat-label">Связей</span></div>
  </div>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Архив</span>
        <h2>Холсты</h2>
      </div>
      <a href={`${base}notes/`}>Все холсты →</a>
    </div>

    <div class="note-list">
      {canvases.slice(0, 10).map((canvas, index) => (
        <a class="note-row" href={`${base}notes/${canvas.slug}/`}>
          <span class="note-index">{String(index + 1).padStart(2, '0')}</span>
          <span>
            <span class="note-row-title">{canvas.title}</span>
            <span class="note-row-desc">{canvas.folder || 'Без раздела'}</span>
          </span>
          <span class="note-row-meta">
            <span>{formatDate(canvas.updated)}</span>
            <span class="note-arrow">↗</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Карта</span>
        <h2>Разделы</h2>
      </div>
    </div>
    <div class="folder-grid">
      {folderList.map(([name, count]) => (
        <a class="folder-card" href={folderUrl(name)}>
          <span class="folder-icon">◈</span>
          <div class="folder-name">{name}</div>
          <div class="folder-count">{count} холстов</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

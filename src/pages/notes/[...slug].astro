---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CanvasView from '../../components/CanvasView.astro';
import manifest from '../../data/manifest.json';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const sorted = [...notes].sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
  return notes.map((note) => {
    const index = sorted.findIndex((item) => item.id === note.id);
    return {
      params: { slug: note.data.slug },
      props: {
        note,
        prev: index > 0 ? sorted[index - 1] : null,
        next: index < sorted.length - 1 ? sorted[index + 1] : null,
      },
    };
  });
}

const { note, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const base = import.meta.env.BASE_URL;

const backlinkSlugs = manifest.backlinks[note.data.slug] || [];
const backlinks = backlinkSlugs
  .map((slug) => manifest.notes.find((item) => item.slug === slug))
  .filter(Boolean)
  .slice(0, 8);

const canvas = (manifest.canvases as Record<string, any>)[note.data.slug] || null;
const isCanvas = note.data.kind === 'canvas' || Boolean(canvas);
const date = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(note.data.updated);
const readingTime = Math.max(1, Math.round((manifest.notes.find((n) => n.slug === note.data.slug)?.words || 300) / 180));
---

<BaseLayout title={`${note.data.title} · ${manifest.siteTitle}`} description={note.data.description}>
  <div class="note-layout">
    <article>
      <header class="note-header">
        <nav class="crumbs" aria-label="Навигация">
          <a href={base}>Главная</a><span>/</span>
          <a href={`${base}notes/`}>Заметки</a><span>/</span>
          {note.data.folder && <><span>{note.data.folder}</span><span>/</span></>}
          <span>{note.data.title}</span>
        </nav>
        <h1 class="note-title">{note.data.title}</h1>
        {isCanvas && <span class="kind-badge">◇ ОБЪЕКТНЫЙ ХОЛСТ</span>}
        <div class="note-meta">
          <span>◷ {date}</span>
          <span>⏱ {readingTime} мин чтения</span>
          {note.data.folder && <span>◈ {note.data.folder}</span>}
        </div>
      </header>

      {canvas ? <CanvasView canvas={canvas} /> : <div class="prose"><Content /></div>}

      <footer class="note-footer">
        {note.data.tags.length > 0 && (
          <div class="note-tags">
            {note.data.tags.map((tag) => (
              <a class="tag" href={`${base}tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
            ))}
          </div>
        )}

        <div class="prev-next">
          {prev && (
            <a class="pn-card" href={`${base}notes/${prev.data.slug}/`}>
              <span>← новее</span><strong>{prev.data.title}</strong>
            </a>
          )}
          {next && (
            <a class="pn-card" href={`${base}notes/${next.data.slug}/`}>
              <span>старее →</span><strong>{next.data.title}</strong>
            </a>
          )}
        </div>
      </footer>
    </article>

    <aside class="side">
      {headings.length > 0 && (
        <div class="side-box">
          <p class="side-title">На этой странице</p>
          <ul class="toc">
            {headings.filter((heading) => heading.depth <= 3).map((heading) => (
              <li class={heading.depth === 3 ? 'toc-3' : ''}>
                <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {backlinks.length > 0 && (
        <div class="side-box">
          <p class="side-title">Ссылаются сюда · {backlinkSlugs.length}</p>
          <div class="backlink-list">
            {backlinks.map((item) => (
              <a href={`${base}notes/${item.slug}/`}>↳ {item.title}</a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>

  <script>
    const links = [...document.querySelectorAll('[data-toc-link]')];
    const targets = links
      .map((link) => ({ link, el: document.getElementById(link.dataset.tocLink || '') }))
      .filter((entry) => entry.el);

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) => { link.dataset.active = 'false'; });
        const active = links.find((link) => link.dataset.tocLink === entry.target.id);
        if (active) active.dataset.active = 'true';
      }
    }, { rootMargin: '-100px 0px -70% 0px' });

    targets.forEach(({ el }) => observer.observe(el));
  </script>
</BaseLayout>

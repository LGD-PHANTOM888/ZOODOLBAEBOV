---
import BaseLayout from '../../layouts/BaseLayout.astro';
import manifest from '../../data/manifest.json';
import folderUrl from '../../utils/folder-url';

const base = import.meta.env.BASE_URL;
const canvases = [...manifest.notes];

const groups = new Map();
for (const canvas of canvases) {
  const folder = canvas.folder || 'Без раздела';
  if (!groups.has(folder)) groups.set(folder, []);
  groups.get(folder).push(canvas);
}
const entries = [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0], 'ru'));
const anchor = (value) => value.replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '').toLowerCase();
---

<BaseLayout title={`Холсты · ${canvases.length}`} description="Все холсты по разделам" active="notes">
  <div style="padding-top:58px">
    <span class="eyebrow">Архив</span>
    <div class="section-head" style="margin-top:10px">
      <h2>Холсты</h2>
      <p>{canvases.length} в {entries.length} разделах</p>
    </div>

    {entries.map(([folder, items]) => (
      <section class="section" id={anchor(folder)} style="margin-top:44px">
        <div class="section-head">
          <h2 style="font-size:26px">{folder}</h2>
          <p><a href={folderUrl(folder)}>граф раздела →</a> · {items.length}</p>
        </div>
        <div class="note-list">
          {items.sort((a, b) => a.title.localeCompare(b.title, 'ru')).map((canvas, i) => (
            <a class="note-row" href={`${base}notes/${canvas.slug}/`}>
              <span class="note-index">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="note-row-title">{canvas.title}</span>
                <span class="note-row-desc">{canvas.folder || 'Без раздела'}</span>
              </span>
              <span class="note-row-meta">
                <span class="mini-badge">ХОЛСТ</span>
                <span class="note-arrow">↗</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

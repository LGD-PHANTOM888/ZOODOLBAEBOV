---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import folderUrl from '../../utils/folder-url';

const base = import.meta.env.BASE_URL;
const notes = await getCollection('notes');

const groups = new Map();
for (const note of notes) {
  const folder = note.data.folder || 'Без папки';
  if (!groups.has(folder)) groups.set(folder, []);
  groups.get(folder).push(note);
}
const entries = [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0], 'ru'));
const anchor = (value) => value.replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '').toLowerCase();
---

<BaseLayout title={`Заметки · ${notes.length}`} description="Все заметки по разделам" active="notes">
  <div style="padding-top:58px">
    <span class="eyebrow">Архив</span>
    <div class="section-head" style="margin-top:10px">
      <h2>Все заметки</h2>
      <p>{notes.length} записей в {entries.length} разделах</p>
    </div>

    {entries.map(([folder, items]) => (
      <section class="section" id={anchor(folder)} style="margin-top:44px">
        <div class="section-head">
          <h2 style="font-size:26px">{folder}</h2>
          <p><a href={folderUrl(folder)}>граф раздела →</a> · {items.length}</p>
        </div>
        <div class="note-list">
          {items.sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru')).map((note, i) => (
            <a class="note-row" href={`${base}notes/${note.data.slug}/`}>
              <span class="note-index">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="note-row-title">{note.data.title}</span>
                <span class="note-row-desc">{note.data.description || '—'}</span>
              </span>
              <span class="note-row-meta">
                {note.data.kind === 'canvas' && <span class="mini-badge">ХОЛСТ</span>}
                <span class="note-arrow">↗</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import manifest from '../data/manifest.json';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Предложка · ${manifest.siteTitle}`} description="Предложения и комментарии" active="predlozhka">
  <div class="page-top form-page">
    <nav class="crumbs"><a href={base}>Главная</a><span>/</span><span>Предложка</span></nav>
    <span class="eyebrow">FEEDBACK</span>
    <h1>Предложка</h1>

    <section class="form-card" data-suggest-form>
      <div class="form-auth">
        <button class="auth-btn" type="button" data-suggest-login>GOOGLE</button>
      </div>

      <form data-suggest-body hidden>
        <label>
          <span>Предложение</span>
          <textarea data-suggest-text maxlength="3000" rows="7" placeholder="Что добавить или исправить" required></textarea>
        </label>
        <div class="form-foot">
          <span data-suggest-status></span>
          <button class="btn btn-primary" type="submit">ОТПРАВИТЬ</button>
        </div>
      </form>

      <div class="suggest-list" data-suggest-list></div>
    </section>
  </div>
</BaseLayout>

<script>
  import { collection, addDoc, onSnapshot, query, where, serverTimestamp } from 'firebase/firestore';
  import { configured, db, subscribeAuth, loginWithGoogle } from '../scripts/firebase';

  const root = document.querySelector('[data-suggest-form]');
  const form = root?.querySelector('[data-suggest-body]');
  const textarea = root?.querySelector('[data-suggest-text]');
  const loginBtn = root?.querySelector('[data-suggest-login]');
  const status = root?.querySelector('[data-suggest-status]');
  const list = root?.querySelector('[data-suggest-list]');

  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  })[char]);

  let currentUser = null;
  let unsubscribeList = null;

  function watchSuggestions(user) {
    unsubscribeList?.();
    unsubscribeList = null;
    if (!db || !user || !list) return;
    const feed = query(collection(db, 'suggestions'), where('uid', '==', user.uid));
    unsubscribeList = onSnapshot(feed, (snapshot) => {
      const items = snapshot.docs
        .map((doc) => ({ id: doc.id, ...doc.data() }))
        .sort((a, b) => (b.createdAt?.toMillis?.() || 0) - (a.createdAt?.toMillis?.() || 0));
      if (!items.length) {
        list.innerHTML = '';
        return;
      }
      list.innerHTML = `<div class="suggest-title">ОТПРАВЛЕНО · ${items.length}</div>` + items.map((item) => {
        const time = item.createdAt?.toMillis?.() || 0;
        const date = time ? new Date(time).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '';
        return `
          <article class="suggest-item">
            <div><span>${escapeHtml(date)}</span></div>
            <p>${escapeHtml(item.text)}</p>
          </article>`;
      }).join('');
    });
  }

  if (!configured && status) status.textContent = 'НЕТ ПОДКЛЮЧЕНИЯ';

  subscribeAuth((user) => {
    currentUser = user;
    if (form instanceof HTMLFormElement) form.hidden = !user;
    if (loginBtn instanceof HTMLButtonElement) {
      loginBtn.hidden = Boolean(user);
      loginBtn.disabled = !configured;
    }
    watchSuggestions(user);
  });

  loginBtn?.addEventListener('click', async () => {
    if (!configured) return;
    loginBtn.textContent = '…';
    try {
      await loginWithGoogle();
    } catch (_) {
      loginBtn.textContent = 'ПОВТОРИТЬ';
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!db || !currentUser || !textarea || !status) return;
    const text = textarea.value.trim();
    if (!text) return;
    status.textContent = '…';
    try {
      await addDoc(collection(db, 'suggestions'), {
        text,
        uid: currentUser.uid,
        authorName: currentUser.displayName || currentUser.email || 'USER',
        authorEmail: currentUser.email || '',
        createdAt: serverTimestamp(),
        status: 'new',
      });
      textarea.value = '';
      status.textContent = '';
    } catch (_) {
      status.textContent = 'ОШИБКА';
    }
  });
</script>
